{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ftlite-signalling-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-23",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Directory"] }]
}
