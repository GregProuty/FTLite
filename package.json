{
  "name": "ftlite",
  "version": "0.0.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:flight": "tsx scripts/dev-mode.ts flight",
    "dev:duel": "tsx scripts/dev-mode.ts duel",
    "build": "electron-vite build",
    "build:web": "tsx scripts/web/build-web.ts",
    "build:vercel": "tsx scripts/web/fetch-paid-art.ts && npm run build:web && tsx scripts/web/check-output.ts .vercel/output",
    "deploy:web": "npm run build:web && tsx scripts/web/check-output.ts .vercel/output && vercel deploy --prebuilt --prod",
    "test:web-output": "tsx scripts/web/build-web.ts --test --allow-missing-paid --service-origin=http://127.0.0.1:8787 --out=out/web-output-check && tsx scripts/web/check-output.ts out/web-output-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:determinism": "tsx scripts/determinism/run.ts",
    "test:worker-boot": "electron-vite build && electron scripts/network/worker-boot.cjs",
    "test:host-runtime": "electron-vite build && tsx scripts/network/host-smoke.ts",
    "test:rtc-runtime": "electron-vite build && tsx scripts/network/rtc-smoke.ts",
    "test:room-service-runtime": "electron-vite build && tsx scripts/network/room-service-smoke.ts",
    "test:online-app-runtime": "electron-vite build && tsx scripts/network/online-app-smoke.ts",
    "test:online-recovery-runtime": "electron-vite build && tsx scripts/network/online-recovery-smoke.ts",
    "test:duel-app-runtime": "electron-vite build && tsx scripts/network/duel-app-smoke.ts",
    "test:internet-app-runtime": "tsx scripts/network/internet-app-smoke.ts",
    "test:bg-tab": "tsx scripts/web/bg-tab/run.ts",
    "test:web-net": "electron-vite build && tsx scripts/web/net/web-net-smoke.ts",
    "test:web-live": "tsx scripts/web/live-smoke.ts",
    "test:web-live-local": "tsx scripts/web/live/local-smoke.ts",
    "package:candidate": "electron-builder --win --dir --publish never -c.win.signAndEditExecutable=false",
    "test:signalling": "npm --prefix services/signalling test",
    "typecheck:signalling": "npm --prefix services/signalling run typecheck",
    "build:signalling": "npm --prefix services/signalling run build",
    "typecheck": "tsc -b",
    "bless": "tsx scripts/bless-golden.ts",
    "acceptance": "tsx scripts/acceptance.ts",
    "credits": "tsx scripts/gen-credits.ts",
    "gen:headings": "tsx scripts/gen-headings.ts",
    "dist": "electron-vite build && electron-builder --win",
    "art:import": "tsx scripts/art-import.ts",
    "art:palette": "tsx scripts/art-palette.ts",
    "art:stars": "tsx scripts/art-stars.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.0.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "37.10.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "fake-indexeddb": "6.0.0",
    "fast-check": "^3.22.0",
    "jsdom": "31.0.1",
    "playwright": "1.48.2",
    "pngjs": "7.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.8.0",
    "vercel": "65.10.0",
    "vite": "^7.0.0",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "bitecs": "0.4.0",
    "pixi-filters": "6.1.5",
    "pixi.js": "8.19.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^3.23.0",
    "zustand": "5.1.0"
  }
}
