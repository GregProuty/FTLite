+    }
+    const ok = [...base]; ok[fieldIndex(st, 'systems.0.laserRock')] = cap - 1; ok[fieldIndex(st, 'systems.0.torpRockFlying')] = -2;
+    expect(() => validateTacticalValues(st, ok)).not.toThrow();
+  });
