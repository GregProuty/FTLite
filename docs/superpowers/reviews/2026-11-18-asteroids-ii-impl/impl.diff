+    expect(rockEffectDraw(speck, at(huge), huge)!.r).toBeCloseTo(2 * rockEffectDraw(speck, at(big), big)!.r, 9);
+    expect(rockEffectDraw(core, at(huge), huge)!.r).toBeCloseTo(2 * rockEffectDraw(core, at(big), big)!.r, 9);
